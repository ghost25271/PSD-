{
  "manifest_version": 3,
  "name": "Швидкий набір",
  "version": "1.101.2",
  "description": "Легкий speed dial замість стартової сторінки Chrome: плитки, сторінки, фони, власні іконки.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "favicon",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "idle"
  ],
  "optional_permissions": ["history"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["panic.js", "lock.js"], "run_at": "document_start" }],
  "action": {
    "default_title": "Додати поточний сайт у Швидкий набір",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}